# Copy to .env (never commit .env). Everything is optional: with nothing set,
# the app runs with PROVIDER=echo and SQLite so you can test the pipeline.

PROVIDER=echo            # echo | gemini | openai | anthropic | local

# Use a PERSONAL Google account for this key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash     # check AI Studio for the current model names

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# "local" = ANY OpenAI-compatible server. Defaults point at Ollama.
#   Ollama:    http://localhost:11434/v1        (LOCAL_MODEL=llama3.1:8b)
#   Modal/vLLM: https://<you>--junction-llm-serve.modal.run/v1
#   Featherless: https://api.featherless.ai/v1  (+ LOCAL_API_KEY)
LOCAL_BASE_URL=
LOCAL_MODEL=llama3.1:8b
LOCAL_API_KEY=

# Leave empty for SQLite. For Postgres (docker compose / Aiven / Tiger Data):
# DATABASE_URL=postgresql://junction:junction@localhost:5432/junction
DATABASE_URL=
