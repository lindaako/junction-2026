# Copy this file to .env in the repo root and fill in your key (never commit .env).
# Create or edit it in a text editor, saved as plain UTF-8.

# Required: the app and the pipeline use Claude models through the Anthropic API.
ANTHROPIC_API_KEY=

# Optional: only for --provider gemini in stoa_vision_test.py / stoa_graph.py
GEMINI_API_KEY=
